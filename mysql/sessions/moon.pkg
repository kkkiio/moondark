import {
  "xziheng/moondark/database/sql",
  "xziheng/moondark/database/sql/driver",
  "xziheng/moondark/sessions" @moondark_sessions,
  "moonbitlang/core/json",
}

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "xziheng/moondark/sessions/sessionstest",
  "xziheng/moondark_mysql/database" @mysql_database,
  "xziheng/testcontainers/mysql",
} for "test"

supported_targets = "native"

// moon link options do not propagate from dependencies: every package that
// links xziheng/moondark_mysql/database into an executable (incl. test exes)
// must repeat these flags.

options(
  link: {
    "native": {
      "cc-link-flags": "-L/opt/homebrew/opt/mariadb-connector-c/lib -lmariadb",
    },
  },
)
